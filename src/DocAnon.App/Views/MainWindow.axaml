<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DocAnon.App.ViewModels"
        xmlns:ctl="using:DocAnon.App.Controls"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vault="using:DocAnon.Core.Vault"
        xmlns:prof="using:DocAnon.Core.Profiles"
        x:Class="DocAnon.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DocAnon — anonimização local de documentos"
        Icon="avares://DocAnon/Assets/DocAnon.ico"
        Width="1400" Height="900" MinWidth="1000" MinHeight="650">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Session and profile -->
    <Border Grid.Row="0" Padding="10,8" Classes="headerBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Sessão:" VerticalAlignment="Center" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding StoredSessions}" SelectedItem="{Binding SelectedStoredSession}" Width="230" PlaceholderText="sessões salvas">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vault:StoredItem">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="action" Content="Abrir" Command="{Binding OpenSessionCommand}" />
          <Button Classes="action" Content="Apagar" Command="{Binding DeleteSessionCommand}" ToolTip.Tip="Apaga o cofre desta sessão, sobrescrevendo o arquivo." />
          <TextBox Text="{Binding NewSessionLabel}" Width="170" PlaceholderText="rótulo da nova sessão" />
          <Button Classes="action" Content="Nova sessão" Command="{Binding NewSessionCommand}" />
          <TextBox Text="{Binding VaultPassword}" PasswordChar="●" Width="150" PlaceholderText="senha do cofre" IsVisible="{Binding UsesPassword}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SessionTitle}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProfileTitle}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding StoredProfiles}" SelectedItem="{Binding SelectedStoredProfile}" Width="190" PlaceholderText="perfis de empresa">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vault:StoredItem">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="action" Content="Usar" Command="{Binding LoadProfileCommand}" />
          <Button Classes="action" Content="Sem perfil" Command="{Binding ClearProfileCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="8">

      <!-- 1. Documents -->
      <TabItem Header="1. Documentos">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="10">
            <Border x:Name="DropZone" Classes="detailsCard" Height="170" DragDrop.AllowDrop="True">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Arraste documentos para cá" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding FileFilterDescription}" HorizontalAlignment="Center" MaxWidth="520" TextAlignment="Center" />
                <Button Classes="action" x:Name="OpenFilesButton" Content="Escolher arquivos..." HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Classes="groupHeader" Text="Ou cole um texto" />
            <TextBox Text="{Binding PastedText}" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" Height="220" PlaceholderText="cole aqui o texto que você quer enviar à IA" />
            <Button Classes="action" Content="Analisar texto colado" Command="{Binding AddPastedTextCommand}" />
            <TextBlock Classes="muted" Text="O DocAnon lê e anonimiza tudo neste computador. O único acesso de rede possível é ao Ollama local (127.0.0.1), se você o ligar nas configurações." />
          </StackPanel>
          <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Classes="groupHeader" Text="Documentos desta sessão" />
            <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentItem">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Status}" />
                    <TextBlock Classes="muted" Text="{Binding Warnings}" Foreground="{DynamicResource DetailsWarningForeground}" IsVisible="{Binding HasWarnings}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 2. Review -->
      <TabItem Header="2. Revisão">
        <Grid ColumnDefinitions="200,*,480" ColumnSpacing="8">
          <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentItem">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Status}" FontSize="{DynamicResource FontSizeSmall}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TabControl Grid.Column="1">
            <TabItem Header="Texto">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,4"
                           Text="Selecione um trecho e use o botão direito para marcar, adicionar ao perfil ou criar uma exceção." />
                <ae:TextEditor x:Name="Editor" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"
                               WordWrap="True" ShowLineNumbers="False">
                  <ae:TextEditor.ContextMenu>
                    <ContextMenu x:Name="EditorMenu">
                      <MenuItem x:Name="MarkMenu" Header="Anonimizar seleção como" />
                      <MenuItem x:Name="ProfileMenu" Header="Adicionar ao perfil da empresa como" />
                      <MenuItem x:Name="NeverMenu" Header="Nunca anonimizar este termo" />
                    </ContextMenu>
                  </ae:TextEditor.ContextMenu>
                </ae:TextEditor>
              </DockPanel>
            </TabItem>
            <TabItem Header="Imagens">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                  <ComboBox x:Name="PageCombo" Width="320" ItemsSource="{Binding SelectedDocument.Pages, FallbackValue={x:Null}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PageItem">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="PageExport" Content="Exportar esta imagem" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,4"
                           Text="Vermelho: palavras que recebem marcador. Azul: logotipos e regiões do perfil (clique para ligar ou desligar). Arraste para desenhar uma tarja; botão direito remove." />
                <ctl:PageView x:Name="PageView" ClipToBounds="True" />
              </DockPanel>
            </TabItem>
          </TabControl>

          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
              <Button Content="Anonimizar e verificar vazamentos" Command="{Binding ExportCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Classes="groupHeader" Text="O que será alterado" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SelectedDocument.Groups, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EntityGroup">
                    <Border Classes="entityRow">
                      <Grid ColumnDefinitions="Auto,110,*,Auto" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding Note}">
                        <CheckBox IsChecked="{Binding Include}" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat='×{0}'}" Opacity="0.7" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                          <TextBlock Text="→" Opacity="0.6" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Preview}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" VerticalAlignment="Center" />
                          <ComboBox ItemsSource="{x:Static vm:MainViewModel.QuantityActions}" SelectedIndex="{Binding ActionIndex}" IsVisible="{Binding IsQuantity}" FontSize="{DynamicResource FontSizeSmall}" MinHeight="24" Padding="4,0" />
                          <TextBlock Text="{Binding Detectors}" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 3. Export -->
      <TabItem Header="3. Exportação">
        <Grid ColumnDefinitions="*,420" ColumnSpacing="10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
              <Button x:Name="CopyTextButton" Content="Copiar texto" IsEnabled="{Binding CanCopy}" Classes="primary" />
              <Button Classes="action" x:Name="SavePackageButton" Content="Salvar pacote..." IsEnabled="{Binding CanCopy}" />
              <TextBlock Text="{Binding ExportSummary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox Text="{Binding ExportText}" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, monospace" />
          </DockPanel>
          <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
              <TextBlock Classes="groupHeader" Text="Checagem de vazamento" />
              <ItemsControl ItemsSource="{Binding Leaks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LeakItem">
                    <StackPanel Margin="0,2">
                      <TextBlock Classes="leak" Text="{Binding Text}" />
                      <TextBlock Classes="muted" Text="{Binding Reason}" FontSize="{DynamicResource FontSizeSmall}" />
                      <TextBlock Classes="muted" Text="{Binding Where}" FontSize="{DynamicResource FontSizeSmall}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox IsChecked="{Binding LeaksAcknowledged}" Content="Revisei os pontos acima e quero liberar a cópia" />
              <TextBlock Classes="groupHeader" Text="Imagens tarjadas" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl x:Name="ImagesList" ItemsSource="{Binding ExportImages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RedactedImage">
                    <StackPanel Margin="0,4" Spacing="4">
                      <TextBlock Text="{Binding Source}" />
                      <Image Source="{Binding Bitmap}" MaxHeight="260" Stretch="Uniform" />
                      <Button Classes="action" Content="Copiar imagem" Tag="{Binding}" Click="CopyImage_Click" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanCopy}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 4. Reidentification -->
      <TabItem Header="4. Reidentificação">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Classes="groupHeader" Text="Cole a resposta da IA" />
          <TextBox Grid.Row="1" Text="{Binding AnswerText}" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, monospace" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="Restaurar valores reais" Command="{Binding RestoreCommand}" Classes="primary" />
            <TextBlock Classes="muted" Text="Use a mesma sessão em que o documento foi anonimizado." VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="groupHeader" Text="Texto com os valores reais" />
          <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="*,Auto,160">
            <TextBox Text="{Binding RestoredText}" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, monospace" />
            <TextBlock Grid.Row="1" Text="{Binding RestoreSummary}" TextWrapping="Wrap" Margin="0,6" />
            <ListBox Grid.Row="2" ItemsSource="{Binding RestoredItems}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RestoredView">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Kind}" Opacity="0.6" Width="140" />
                    <TextBlock Text="{Binding Found}" FontFamily="Cascadia Mono, Consolas, monospace" />
                    <TextBlock Text="→" />
                    <TextBlock Text="{Binding Restored}" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Button Classes="action" Grid.Column="1" Grid.Row="2" x:Name="CopyRestoredButton" Content="Copiar texto restaurado" Margin="0,6,0,0" />
        </Grid>
      </TabItem>

      <!-- 5. Settings -->
      <TabItem Header="5. Configurações">
        <ScrollViewer>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="groupHeader" Text="Perfil da empresa" />
              <TextBlock Classes="muted" Text="Termos sempre anonimizados, exceções, logotipos e regiões fixas. O perfil é salvo cifrado." />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding ProfileName}" Width="260" PlaceholderText="nome do perfil" />
                <Button Classes="action" Content="Novo perfil" Command="{Binding NewProfileCommand}" />
                <Button Content="Salvar perfil" Command="{Binding SaveProfileCommand}" Classes="primary" />
              </StackPanel>
              <TextBlock Text="Termos (variantes separadas por ;)" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding ProfileTerms}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileTermItem">
                    <Grid ColumnDefinitions="2*,150,2*,Auto" ColumnSpacing="4" Margin="0,2">
                      <TextBox Text="{Binding Text}" PlaceholderText="termo" />
                      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.EntityTypes}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />
                      <TextBox Grid.Column="2" Text="{Binding Aliases}" PlaceholderText="variantes" />
                      <Button Classes="action" Grid.Column="3" Content="✕" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveProfileTermCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="action" Content="Adicionar termo" Command="{Binding AddProfileTermCommand}" />
              <TextBlock Text="Exceções (nunca anonimizar), uma por linha" FontWeight="SemiBold" />
              <TextBox Text="{Binding ProfileExceptions}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="90" />
              <TextBlock Text="Padrões de prefixo de unidade nas tags (regex), um por linha" FontWeight="SemiBold" />
              <TextBox Text="{Binding ProfileUnitPatterns}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="60" PlaceholderText="vazio: prefixos numéricos como 2100- contam como unidade" />
              <TextBlock Text="Padrões (TIPO: expressão regular), um por linha" FontWeight="SemiBold" />
              <TextBox Text="{Binding ProfilePatterns}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="80" FontFamily="Cascadia Mono, Consolas, monospace" PlaceholderText="CONTRATO: \d{4}\.\d{7}\.\d{2}\.\d" />
              <CheckBox IsChecked="{Binding ProfileAnonymizeAllTags}" Content="Anonimizar todas as tags de equipamentos e instrumentos" />
              <CheckBox IsChecked="{Binding ProfileCoverSmallImages}" Content="Cobrir imagens pequenas nos desenhos (logotipos, carimbos, assinaturas)" />
              <TextBlock Text="Logotipos procurados em cada página" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding ProfileLogos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="prof:LogoTemplate">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="200" />
                      <Button Classes="action" Content="Remover" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveLogoCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="action" x:Name="AddLogoButton" Content="Adicionar logotipo (PNG recortado)..." />
              <TextBlock Text="Regiões fixas (frações da página, 0 a 1)" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding ProfileRegions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="prof:RelativeRegion">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                      <TextBox Text="{Binding Label}" Width="110" />
                      <NumericUpDown Value="{Binding X}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" Width="100" />
                      <NumericUpDown Value="{Binding Y}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" Width="100" />
                      <NumericUpDown Value="{Binding Width}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" Width="100" />
                      <NumericUpDown Value="{Binding Height}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" Width="100" />
                      <Button Classes="action" Content="✕" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRegionCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="action" Content="Adicionar região" Command="{Binding AddRegionCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Classes="groupHeader" Text="Detecção" />
              <CheckBox IsChecked="{Binding Settings.UseNer}" Content="Reconhecimento de nomes (modelo NER local)" />
              <CheckBox IsChecked="{Binding Settings.UseFirstNames}" Content="Lista de prenomes comuns (ajuda em carimbos e tabelas)" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Resolução das imagens (dpi):" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Settings.Dpi}" Minimum="100" Maximum="400" Increment="50" Width="130" />
              </StackPanel>
              <TextBlock Classes="groupHeader" Text="Escala dos números" />
              <TextBlock Classes="muted" Text="Cada nova sessão sorteia dois fatores secretos dentro deste intervalo, longe de 1." />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <NumericUpDown Value="{Binding Settings.ScaleMin}" Minimum="0.1" Maximum="0.8" Increment="0.05" FormatString="0.00" Width="130" />
                <TextBlock Text="a" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Settings.ScaleMax}" Minimum="1.25" Maximum="10" Increment="0.25" FormatString="0.00" Width="130" />
              </StackPanel>
              <TextBlock Classes="groupHeader" Text="Cofres" />
              <ComboBox SelectedItem="{Binding Settings.Protection}" Width="260">
                <ComboBox.Items>
                  <x:String>windows</x:String>
                  <x:String>senha</x:String>
                </ComboBox.Items>
              </ComboBox>
              <TextBlock Classes="muted" Text="windows: o cofre só abre com o seu usuário do Windows. senha: o cofre abre em qualquer computador com a senha." />
              <TextBlock Classes="groupHeader" Text="LLM local (Ollama)" />
              <CheckBox IsChecked="{Binding Settings.UseLlm}" Content="Usar o Ollama para sugerir entidades, desfazer dúvidas e auditar" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding Settings.OllamaAddress}" Width="260" />
                <Button Classes="action" Content="Testar e listar modelos" Command="{Binding TestOllamaCommand}" />
              </StackPanel>
              <TextBlock Text="Modelo de texto" />
              <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding Settings.LlmTextModel}" Width="260" PlaceholderText="{Binding Settings.LlmTextModel}" />
              <TextBlock Text="Modelo de visão (opcional)" />
              <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding Settings.LlmVisionModel}" Width="260" PlaceholderText="{Binding Settings.LlmVisionModel}" />
              <TextBlock Classes="muted" Text="Só endereços deste computador são aceitos (127.0.0.1, ::1, localhost). As sugestões do LLM começam desmarcadas na revisão." />
              <Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" Classes="primary" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Status -->
    <Border Grid.Row="2" Padding="10,6" Classes="headerBar">
      <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
        <Button Classes="action" Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
